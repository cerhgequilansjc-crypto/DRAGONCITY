    * {
    box-sizing: border-box;
    padding: 0;
    margin: 0;
}

.container {
    display: flex;
    justify-content: center;
    flex-wrap: nowrap;
}

.card {
    background: grey;
    width: 100px;
    height: 680px;
    margin: 8px;
}
.card-image {
    background-color: aqua;
    height: 180px;
    margin-bottom: 53px;
    background-size: cover;
    border-radius: 10px 10px 0 0;
}

.car-1 {
    background-image: url(https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSa4P_UeAdUIlg2zQgjfZZdk39KXCpKHVQSiR07GpnS1w&s);
}   

.car-2 {
    background-image: url(https://www.virtualpetlist.com/showcase/dragon-city.121/cover-image);
}   

.car-3 {
    background-image: url(https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSDu3qbTE9VpmXyohOZUMfIPL8M4fT0JGnkXjT0UCd65g&s=10);
}   
.car-4 {
    background-image: url(https://images.ctfassets.net/7qho9llfhoio/2ul9ZsAnbjTDpQDheUK9TF/673e9d0adb441eae842a3e7fcd86cbae/1198422578_Website_Asset_4_Battle_2.jpg?w=1920&h=&fm=avif&q=75);
}   

.card a{
    background-color: black;
    color: white;
    padding: 15px 15px;
    display: block;    
    text-align: center;
    margin: 10px 40px;
}
.card:hover {

    background-color: black;
    color: white;
    cursor: pointer;
    transform: scale(1.06);
    transition: all 1s ease;
} 
.card {
    width: 400px;
    padding: 3px;
    border: 6px solid goldenrod;
    border-radius: 10px; 
}
li {
  display: block;
  color: white;
  text-align: center;
  padding: 2px 30px;
  text-decoration: none;
}
