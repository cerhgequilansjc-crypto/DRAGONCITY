* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
}

body {
      min-height: 100vh;
      background-color: #080c14;
      background-image: url("https://scontent.fmnl17-3.fna.fbcdn.net/v/t1.15752-9/767299842_1655790449890491_4545257964467939193_n.jpg?stp=dst-jpg_tt6&cstp=mx2730x1374&ctp=s2048x2048&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=9f807c&_nc_eui2=AeGM4_41mJ3LzK9dCWrfPUarlU8g-dacNnOVTyD51pw2c567HQcAVzanhm9n9mFQUha7lkcVy3AcAFiBy9nT1CmH&_nc_ohc=iILIBuR1VC8Q7kNvwGtrVs6&_nc_oc=AdrgYi3_kR99PQsobkBZdY6h78Ep0LK1CM7NGzYD1GocTQRpbVBkbWe7cVYGbLGtliY&_nc_zt=23&_nc_ht=scontent.fmnl17-3.fna&_nc_ss=7b2a8&oh=03_Q7cD6AELTnQGtor_LJXfN3qr1uAR7j50Bpd6J6AhI7E_hIDlQw&oe=6AA11DC7");
      background-position: center center;
      background-repeat: no-repeat;
      background-size: cover;
      background-attachment: fixed;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-top: 130px;
      padding-bottom: 50px;
    }
.ui-card {
    background-color: #2c6b8f;
    width: 100%;
    max-width: 580px;
    border-radius: 24px;
    padding: 40px;
    box-shadow: 0 25px 60px rgba(10, 40, 80, 0.76);
    border: 6px solid rgba(202, 4, 4, 0.05);
    position: relative;
    overflow: hidden;
}

.ui-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 200%;
    height: 5px;
    background: linear-gradient(to right, #daee27, #0328ce);
}

/* Header Text Alignments */
.card-header {
    text-align: center;
    margin-bottom: 70px;
}

.main-title {
    color: #e7eb1a;
    font-size: 40px;
    font-weight: 800;
    letter-spacing: 0.5px;
}

.subtitle {
    color: #e7e4e3;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
    margin-top: 6px;
}

/* Statistics Grid Section Layout */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    background-color: #0f4657;
    border-radius: 14px;
    padding: 16px;
    margin-bottom: 35px;
    border: 1px solid rgba(255, 255, 255, 0.02);
}

.stat-item {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.stat-number {
    color: #1d95f8; /* Warm bright gold accent */
    font-size: 25px;
    font-weight: 600;
}

.stat-label {
    color: #f1eded;
    font-size: 11px;
    font-weight: 600;
}

/* Section Title Settings */
.section-title {
    color: #fffcfc;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.5px;
    margin-bottom: 18px;
}

/* ========================================================
   SCROLL LINE CONTAINER (THE CORE FEATURE)
   ======================================================== */
.scroll-content {
    max-height: 250px; /* Limits visible items to trigger scrolling action */
    overflow-y: auto;  /* Directs vertical engine activation */
    padding-right: 16px; /* Essential safety space to offset text from track line */
    
    /* Cross-browser Fallbacks for Firefox styling rules */
    scrollbar-width: thin;
    scrollbar-color: #0efad3 rgba(255, 255, 255, 0.05);
}

/* 1. Customizing Right Scrollbar Track Design (Webkit Browsers) */
.scroll-content::-webkit-scrollbar {
    width: 5px; /* Narrow profile sleek scroll track line width */
}

.scroll-content::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.04); /* Subtle glowing trace line */
    border-radius: 10px;
}
.scroll-content::-webkit-scrollbar-thumb {
    background: linear-gradient(to bottom, #0dbb32, #ff007c); /* Bright gradient layout matching the card header */
    border-radius: 10px;
}

.scroll-content::-webkit-scrollbar-thumb:hover {
    background: #c93e1b; /* Interactive shift feedback glow tint color */
}

/* OPTIONAL LOGIC OVERRIDE: Switches Custom Scroll Line to Left Side */
.scroll-content.scroll-left {
    direction: rtl; /* Forces standard system track location to pivot left */
    padding-right: 0;
    padding-left: 16px;
}
.scroll-content.scroll-left > * {
    direction: ltr; /* Restores standard content block flows left-to-right */
}

/* Individual Content Row Architecture */
.feature-row {
    background-color: #2859a3;
    border-radius: 15px;
    padding: 16px 20px;
    margin-bottom: 20px;
    display: flex;
    align-items: flex-start;
    gap: 20px;
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.02);
}
.feature-row::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10px;
    bottom: 5px;
    width: 5px;
    background-color: #2fe0e0;
    border-radius: 0 10px 10px 0;
}

.feature-icon {
    font-size: 20px;
    margin-top: 2px;
}

.feature-text h3 {
    color: #ffffff;
    font-size: 15px;
    font-weight: 700;
    margin-bottom: 4px;
}

.feature-text p {
    color: #f8f8fa;
    font-size: 13px;
    line-height: 1.5;
}

.card-footer {
    margin-top: 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 20px;
}

.developer-info {
    color: #fad501;
    font-size: 20px;
}

.badge {
    background-color: #291540;
    color: #b66eff;
    font-size: 12px;
    font-weight: 800;
    padding: 6px 14px;
    border-radius: 20px;
    border: 1px solid rgba(182, 110, 255, 0.2);
}

