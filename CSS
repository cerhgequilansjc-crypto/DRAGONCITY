            flex-direction: column;
            align-items: center;
            padding-top: 140px; 
            padding-bottom: 40px;
        }
       .navbar {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 72px;
      background: rgba(12, 16, 24, 0.4);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
        .logo {
            position: absolute;
            left: 15px;
            top: 10px;
            width: 65px;
            height: 50px;
            object-fit: contain;
        }
        .nav-menu {
            display: flex;
            gap: 12px;
            list-style: none;
        }
        .nav-menu a {
            text-decoration: none;
            color: white;
            min-width: 120px;
            padding: 10px 20px;
            text-align: center;
            border: 1px solid rgba(255,255,255,0.3);
            border-radius: 30px;
            font-weight: bold;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.3s ease;
            background: rgba(255, 255, 255, 0.03);
        }
        .nav-menu a:hover {
            background: linear-gradient(135deg, #2cc9e9, #324e96);
            border-color: #fff;
            box-shadow: 0 0 15px #25cfff, inset 0 0 10px rgba(255,255,255,0.3);
            transform: translateY(-2px);
        }  
.ui-card {
    background-color: #2c6b8f;
    width: 100%;
    max-width: 580px;
    border-radius: 24px;
    padding: 40px;
    box-shadow: 0 25px 60px rgba(10, 40, 80, 0.76);
    border: 6px solid rgba(202, 4, 4, 0.05);
    position: relative;
    overflow: hidden;
}

.ui-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 200%;
    height: 5px;
    background: linear-gradient(to right, #daee27, #0328ce);
}

.card-header {
    text-align: center;
    margin-bottom: 70px;
}

.main-title {
    color: #e7eb1a;
    font-size: 40px;
    font-weight: 800;
    letter-spacing: 0.5px;
}

.subtitle {
    color: #e7e4e3;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
    margin-top: 6px;
}
.stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    background-color: #0f4657;
    border-radius: 14px;
    padding: 16px;
    margin-bottom: 35px;
    border: 1px solid rgba(255, 255, 255, 0.02);
}

.stat-item {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.stat-number {
    color: #1d95f8; 
    font-size: 25px;
    font-weight: 600;
}

.stat-label {
    color: #f1eded;
    font-size: 11px;
    font-weight: 600;
}

.section-title {
    color: #fffcfc;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.5px;
    margin-bottom: 18px;
}
.scroll-content {
    max-height: 250px; 
    overflow-y: auto;
    padding-right: 16px; 
    
    
    scrollbar-width: thin;
    scrollbar-color: #0efad3 rgba(255, 255, 255, 0.05);
}
.scroll-content::-webkit-scrollbar {
    width: 5px; 
}

.scroll-content::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.04);
    border-radius: 10px;
}
.scroll-content::-webkit-scrollbar-thumb {
    background: linear-gradient(to bottom, #0dbb32, #ff007c);
    border-radius: 10px;
}

.scroll-content::-webkit-scrollbar-thumb:hover {
    background: #c93e1b; 
}


.scroll-content.scroll-left {
    direction: rtl; 
    padding-right: 0;
    padding-left: 16px;
}
.scroll-content.scroll-left > * {
    direction: ltr; 
}
.feature-row {
    background-color: #2859a3;
    border-radius: 15px;
    padding: 16px 20px;
    margin-bottom: 20px;
    display: flex;
    align-items: flex-start;
    gap: 20px;
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.02);
}
.feature-row::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10px;
    bottom: 5px;
    width: 5px;
    background-color: #2fe0e0;
    border-radius: 0 10px 10px 0;
}

.feature-icon {
    font-size: 20px;
    margin-top: 2px;
}

.feature-text h3 {
    color: #ffffff;
    font-size: 15px;
    font-weight: 700;
    margin-bottom: 4px;
}

.feature-text p {
    color: #f8f8fa;
    font-size: 13px;
    line-height: 1.5;
}

.card-footer {
    margin-top: 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 20px;
}

.developer-info {
    color: #fad501;
    font-size: 20px;
}

.badge {
    background-color: #291540;
    color: #b66eff;
    font-size: 12px;
    font-weight: 800;
    padding: 6px 14px;
    border-radius: 20px;
    border: 1px solid rgba(182, 110, 255, 0.2);
}
