 /* 6. Play Button Styling & Animation */
    .play-btn {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 75px;
      height: 75px;
      background-color: #1f1657;
      border: none;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 8px 24px rgba(223, 177, 91, 0.3);
      transition: background-color 0.2s ease, transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .play-btn svg {
      width: 32px;
      height: 32px;
      color: #1a1512;
      margin-left: 4px; /* Perfectly centers the triangle icon inside the circle */
    }
