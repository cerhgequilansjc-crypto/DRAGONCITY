<script>

let position = 0;

function next() {
    position += 1;

    if(position > 11) {
        position = 10.3 ;
    }

    document.getElementById("cards").style.transform =
    "translateX(-" + position * 38 + "%)";
}

function prev() {
    position -= 1;

    if(position < 0) {
        position = 10.3;
    }

    document.getElementById("cards").style.transform =
    "translateX(-" + position * 38 + "%)";
}

function selectHabitat(name) {
    document.getElementById("message").innerHTML =
    "Selected: " + name;
}

</script>

